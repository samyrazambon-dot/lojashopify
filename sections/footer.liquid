{%- comment -%}
  SAFA — footer: fundo roxo escuro, logo oficial + tagline + contato (SAC/Instagram)
  + socials (IG/TT/YT em círculos), colunas de menu, barra inferior com copyright.
{%- endcomment -%}
<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__top page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__block footer__block--brand" {{ block.shopify_attributes }}>
            {{ 'safa-logo-white.png' | asset_url | image_tag: alt: 'Safa', class: 'footer__logo', width: 130, height: 40 }}
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            <div class="footer__contact">
              {%- if block.settings.contact_email != blank -%}
                <a href="mailto:{{ block.settings.contact_email }}">{{ block.settings.contact_email }}</a>
              {%- endif -%}
              {%- if block.settings.instagram_handle != blank -%}
                <a href="{{ block.settings.instagram_link }}" target="_blank" rel="noopener">{{ block.settings.instagram_handle }}</a>
              {%- endif -%}
            </div>
            <ul class="footer__social" role="list">
              {%- if block.settings.instagram_link != blank -%}
                <li><a href="{{ block.settings.instagram_link }}" target="_blank" rel="noopener">IG</a></li>
              {%- endif -%}
              {%- if block.settings.tiktok_link != blank -%}
                <li><a href="{{ block.settings.tiktok_link }}" target="_blank" rel="noopener">TT</a></li>
              {%- endif -%}
              {%- if block.settings.youtube_link != blank -%}
                <li><a href="{{ block.settings.youtube_link }}" target="_blank" rel="noopener">YT</a></li>
              {%- endif -%}
            </ul>
          </div>

        {%- when 'menu' -%}
          <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {% render 'newsletter-form', block: block %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} Safa Cosméticos · {{ 'sections.footer.rights' | t }}
    </p>
    {%- if section.settings.tagline != blank -%}
      <p class="footer__tagline">{{ section.settings.tagline | escape }} ✦</p>
    {%- endif -%}
  </div>
</footer>

<style>
  .footer {
    background-color: #2a0a2e;
    color: #ffffff;
    margin-top: 0;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px;
    padding-top: 64px;
    padding-bottom: 48px;
  }
  .footer__logo { display: block; height: auto; margin-bottom: 16px; }
  .footer__heading {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ff73d7;
    margin: 0 0 18px;
  }
  .footer__menu { list-style: none; margin: 0; padding: 0; }
  .footer__link { display: inline-block; padding: 6px 0; color: #ffffff; text-decoration: none; font-size: 14px; opacity: 0.85; }
  .footer__link:hover { text-decoration: underline; opacity: 1; }
  .footer__text { font-size: 14px; line-height: 1.6; opacity: 0.75; max-width: 320px; margin-bottom: 16px; }
  .footer__contact { display: flex; flex-direction: column; gap: 4px; margin-bottom: 20px; }
  .footer__contact a { color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; opacity: 0.9; }
  .footer__contact a:hover { text-decoration: underline; opacity: 1; }
  .footer__social { display: flex; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.3);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
  }
  .footer__social a:hover { border-color: #ff73d7; color: #ff73d7; }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    padding-bottom: 32px;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 12px;
  }
  .footer__copyright { margin: 0; opacity: 0.7; }
  .footer__tagline { margin: 0; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #ff73d7; }

  @media screen and (max-width: 900px) {
    .footer__top { grid-template-columns: 1fr 1fr; }
  }
  @media screen and (max-width: 560px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "text", "id": "tagline", "default": "Espalhe o que te ilumina", "label": "Tagline (rodapé, canto direito)" },
    { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.settings.show_social.label" },
    { "type": "checkbox", "id": "show_payment_icons", "default": false, "label": "t:sections.footer.settings.show_payment_icons.label" },
    { "type": "checkbox", "id": "enable_localization", "default": false, "label": "t:sections.footer.settings.enable_localization.label" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.brand.settings.text.label" },
        { "type": "text", "id": "contact_email", "label": "E-mail de contato (SAC)" },
        { "type": "text", "id": "instagram_handle", "label": "Instagram — texto exibido (@usuario)" },
        { "type": "text", "id": "instagram_link", "label": "Instagram (URL)" },
        { "type": "text", "id": "tiktok_link", "label": "TikTok (URL)" },
        { "type": "text", "id": "youtube_link", "label": "YouTube (URL)" }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "default": "Quick links", "label": "t:sections.footer.blocks.menu.settings.heading.label" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "t:sections.footer.blocks.menu.settings.menu.label" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "Subscribe to our newsletter", "label": "t:sections.footer.blocks.newsletter.settings.heading.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
